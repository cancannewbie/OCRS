# 仓库中只保存虚构示例；此文件不得包含真实密钥或客户资料。
# 默认配置用于离线 demo；真实数据使用前先读 docs/OPERATIONS.md。
OCRS_DATA_DIR=~/.ocrs
OCRS_PROVIDER=demo
OCRS_ALLOW_EXTERNAL=false
OCRS_SKUS=DEMO-001

# 留空时使用初始化生成的数据目录/access-token 文件。
# 覆盖时使用私有随机令牌，至少 32 字符；不要提交实际值。
OCRS_ACCESS_TOKEN=

# 只有确认授权与预算后，才选择真实 provider 并开启 OCRS_ALLOW_EXTERNAL。
# 使用 HTTPS 基地址，不含 /chat/completions、凭据或查询参数。
OCRS_MODEL_URL=https://api.openai.com/v1
OCRS_MODEL=
OCRS_API_KEY=

# 可选：专用本地目录，只放手动保存且获授权处理的图片。
# 不要指向微信用户资料、聊天备份或共享/不可信目录；留空禁用。
OCRS_INBOX=

# MiniMax 中国：将上述对应行改为以下值（不要重复定义）：
# OCRS_PROVIDER=minimax-cn
# OCRS_MODEL_URL=https://api.minimax.cn/v1
# OCRS_MODEL=MiniMax-M3
# 密钥仍填 OCRS_API_KEY；账户需有此模型的图片调用权限。
# M2.x 不可用于图片；本适配器未开放 M3.1 Preview。
# MiniMax 是提示词要求 JSON + 本地校验，不宣称供应商强制 JSON schema。
# 首次验证另用空数据目录，例如 ~/.ocrs-minimax-test，OCRS_INBOX 留空。
# 默认仍为 demo / ALLOW_EXTERNAL=false，不会自动调用付费模型。

# 可选有界预算。留作注释时使用 provider 默认值，不要设置空字符串。
# OCRS_MODEL_TIMEOUT_SECONDS=60       # 1..60；MiniMax 默认60，其他15
# OCRS_MODEL_TOTAL_TIMEOUT_SECONDS=120 # 单次超时..180；MiniMax默认120，其他45
# OCRS_MODEL_MAX_OUTPUT_TOKENS=4096    # 1..8192；所有 provider 默认4096
# OCRS_MAX_REQUESTS=100               # 1..100000；含重试，重启后重置，非金额预算
